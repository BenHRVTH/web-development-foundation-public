{
  "name": "hangar-listening-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4183 --strictPort",
    "ui-lab": "wdf-ui-lab",
    "generate:tokens": "node generate.mjs",
    "check:generated": "node generate.mjs --check",
    "qa:browser": "node qa-browser.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@wdf/foundation": "0.1.0-rc.1",
    "@wdf/core": "0.1.0-rc.1",
    "@wdf/adapter-react": "0.1.0-rc.1",
    "@wdf/qa": "0.1.0-rc.1",
    "@wdf/ui-lab": "0.1.0-rc.1",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "zod": "4.6.7",
    "prettier": "3.10.1",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0"
  }
}
