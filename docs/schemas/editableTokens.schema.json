{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "scope": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "global" }
                },
                "required": ["kind"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "family" },
                  "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                },
                "required": ["kind", "family"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "const": "variant" },
                  "family": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "variant": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                },
                "required": ["kind", "family", "variant"],
                "additionalProperties": false
              }
            ]
          },
          "role": { "type": "string", "enum": ["card-padding"] },
          "type": {
            "type": "string",
            "enum": [
              "spacing",
              "dimension",
              "color",
              "fontFamily",
              "fontWeight",
              "number",
              "duration"
            ]
          },
          "value": { "$ref": "#/$defs/__schema0" }
        },
        "required": ["scope", "type", "value"],
        "additionalProperties": false
      }
    },
    "responsive": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "minWidth": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "overrides": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
            },
            "additionalProperties": { "$ref": "#/$defs/__schema1" }
          }
        },
        "required": ["minWidth", "overrides"],
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ruleId": { "type": "string", "minLength": 1 },
          "tokenIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
            }
          },
          "reason": { "type": "string", "minLength": 1 },
          "requestedBy": { "type": "string", "minLength": 1 },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "approval": {
            "type": "object",
            "properties": {
              "approvedBy": { "type": "string", "minLength": 1 },
              "approvedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "decisionId": { "type": "string", "minLength": 1 }
            },
            "required": ["approvedBy", "approvedAt", "decisionId"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "ruleId",
          "tokenIds",
          "reason",
          "requestedBy",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "tokens"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema1" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema1" }
        }
      ]
    }
  }
}
