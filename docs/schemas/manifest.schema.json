{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string" },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "designTokens": {
      "type": "object",
      "properties": {
        "entryPoint": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9_./-]+$"
        },
        "format": { "type": "string", "const": "wdf-tokens@1" }
      },
      "required": ["entryPoint", "format"],
      "additionalProperties": false
    },
    "componentRegistry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": { "type": "string", "const": "deferred" },
            "milestone": { "type": "string", "const": "M2" },
            "entryPoint": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9_./-]+$"
            }
          },
          "required": ["availability", "milestone", "entryPoint"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "availability": { "type": "string", "const": "configured" },
            "entryPoint": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9_./-]+$"
            }
          },
          "required": ["availability", "entryPoint"],
          "additionalProperties": false
        }
      ]
    },
    "preview": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": { "type": "string", "const": "deferred" },
            "milestone": { "type": "string", "const": "M3" },
            "entryPoint": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9_./-]+$"
            }
          },
          "required": ["availability", "milestone", "entryPoint"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "availability": { "type": "string", "const": "configured" },
            "entryPoint": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9_./-]+$"
            },
            "origin": { "type": "string", "format": "uri" },
            "widths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": ["availability", "entryPoint", "origin", "widths"],
          "additionalProperties": false
        }
      ]
    },
    "qa": {
      "type": "object",
      "properties": {
        "hooks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "kind": { "type": "string", "enum": ["static", "browser"] },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["id", "kind", "command"],
            "additionalProperties": false
          }
        }
      },
      "required": ["hooks"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "adapter",
    "designTokens",
    "componentRegistry",
    "preview",
    "qa"
  ],
  "additionalProperties": false
}
