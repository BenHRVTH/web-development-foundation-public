{
  "name": "wdf-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.9.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wdf/task-manager",
    "preview": "npm run preview --workspace @wdf/task-manager",
    "build": "npm run build --workspace @wdf/task-manager",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:spec": "node tools/check-spec.mjs",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser",
    "check": "npm run check:spec && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "verify:m0": "npm run check && npm run test:browser",
    "generate:tokens": "node tools/generate-m1.ts",
    "check:generated": "node tools/generate-m1.ts --check",
    "predev": "npm run check:generated",
    "prebuild": "npm run check:generated",
    "verify:m1": "npm run check:generated && npm run verify:m0",
    "test:fixtures": "vite --config tests/fixtures/vite.config.ts",
    "verify:m2": "npm run check:m2 && npm run verify:m1",
    "check:m2": "node tools/check-m2.ts",
    "ui-lab": "npm run ui-lab --workspace @wdf/task-manager",
    "test:m3": "playwright test --config playwright.m3.config.ts",
    "verify:m3": "node tools/verify-m3.ts",
    "test:m4": "playwright test --config playwright.m4.config.ts",
    "verify:m4": "node tools/verify-m4.ts",
    "test:m5": "playwright test --config playwright.m5.config.ts",
    "verify:m5": "node tools/verify-m5.ts",
    "test:m5:storage": "vitest run --config vitest.m5-portable.config.ts",
    "build:packages": "node tools/build-packages.ts",
    "install:consumer": "node tools/install-consumer.ts",
    "test:m6": "playwright test --config playwright.m6.config.ts",
    "verify:m6": "node tools/verify-m6.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wdf/adapter-react": "0.0.0",
    "@wdf/core": "0.0.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
